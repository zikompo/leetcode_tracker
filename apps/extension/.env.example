# Copy to .env.local. See docs/supabase-setup.md. Without these, LeetTrack works offline only.
WXT_SUPABASE_URL=https://your-project-ref.supabase.co
WXT_SUPABASE_ANON_KEY=your-publishable-or-anon-key
WXT_WEBSITE_URL=http://localhost:3000
# GitHub sync (optional). See docs/github-setup.md.
WXT_GITHUB_CLIENT_ID=
WXT_GITHUB_APP_SLUG=
# The extension's ID is pinned by key.pub.txt (development ID bpjaccjmefnfblponnmbnpkdmiegpcfo).
# Once it's on the Chrome Web Store, put the store's public key here so both IDs match:
# WXT_EXTENSION_KEY=
