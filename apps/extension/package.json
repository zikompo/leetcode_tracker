{
  "name": "@leettrack/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "WXT_E2E=1 WXT_SUPABASE_URL=http://127.0.0.1:54329 WXT_SUPABASE_ANON_KEY=e2e-anon-key WXT_WEBSITE_URL=http://localhost:3000 WXT_GITHUB_CLIENT_ID=Iv1.e2e WXT_GITHUB_APP_SLUG=leettrack-e2e WXT_GITHUB_WEB_URL=http://127.0.0.1:54330 WXT_GITHUB_API_URL=http://127.0.0.1:54330 wxt build && playwright test",
    "zip:store": "WXT_STORE_BUILD=1 wxt zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@leettrack/core": "workspace:*",
    "@leettrack/insights": "workspace:*",
    "@leettrack/seed": "workspace:*",
    "@leettrack/ui": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "idb": "^8.0.4",
    "lucide-react": "1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
