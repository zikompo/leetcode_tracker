# Copy to .env.local. See docs/supabase-setup.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Extension IDs allowed to receive a session (comma-separated): the development ID, plus the
# Chrome Web Store ID once published.
NEXT_PUBLIC_EXTENSION_IDS=bpjaccjmefnfblponnmbnpkdmiegpcfo
# Set to 1 to serve generated sample data instead of Supabase.
LEETTRACK_DEMO=
